OPENAI_API_KEY=your_openai_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Firebase Admin configuration (choose one of the below methods)
# 1) Paste raw JSON (or base64-encoded JSON) of the service account
# FIREBASE_CREDENTIALS_JSON={"type":"service_account", ...}
# or base64-encoded
# FIREBASE_CREDENTIALS_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=

# 2) Provide base64 JSON explicitly
# FIREBASE_CREDENTIALS_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=

# 3) Provide a path to the JSON file
# FIREBASE_CREDENTIALS_PATH=./firebase-admin.json

# Optional: storage bucket (if you use Firebase Storage)
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
